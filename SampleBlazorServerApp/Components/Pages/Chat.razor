@page "/chat"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager NavigationManager

<div class="chat-container">
    <div class="chat-header">
        <h2>Real-Time Chat</h2>
    </div>

    <div class="chat-messages">
        @foreach (ChatMessage message in messages)
        {
            <div class="message @(message.IsCurrentUser ? "sent" : "received")">
                <span class="username">@message.Username</span>
                <span class="content">@message.Content</span>
                <span class="timestamp">@message.Timestamp.ToString("HH:mm:ss")</span>
            </div>
        }
    </div>

    <div class="chat-input-area">
        <input @bind="messageInput" @onkeyup="HandleKeyUp" placeholder="Type a message..." class="message-input"
               disabled="@(!IsConnected)" />
        <button @onclick="SendMessage" class="send-button"
                disabled="@(!IsConnected || string.IsNullOrWhiteSpace(messageInput))">
            Send
        </button>
    </div>

    <div class="connection-status">
        Status: <span class="@(IsConnected ? "connected" : "disconnected")">
        @(IsConnected ? "Connected" : "Disconnected")
    </span>
</div>
</div>

@code {
    private HubConnection? hubConnection;
    private List<ChatMessage> messages = new List<ChatMessage>();

    private string messageInput = string.Empty;
    private string? username = string.Empty;
    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public class ChatMessage
    {
        public string Username { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public bool IsCurrentUser { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        username = $"User{Random.Shared.Next(1000, 9999)}";

        hubConnection = new HubConnectionBuilder()
                    .WithUrl(NavigationManager.ToAbsoluteUri(relativeUri: "/notificationHub"))
                    .WithAutomaticReconnect()
                    .Build();

        hubConnection.On<string, string>(methodName: "ReceiveMessage", async (string user, string message) =>
        {
            messages.Add(new ChatMessage
            {
                Username = user,
                Content = message,
                Timestamp = DateTime.Now,
                IsCurrentUser = user == username
            });
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to hub: {ex.Message}");
        }
    }

    private async Task SendMessage()
    {
        if (hubConnection is not null && !string.IsNullOrWhiteSpace(messageInput))
        {
            try
            {
                await hubConnection.SendAsync("SendMessage", username, messageInput);
                messageInput = string.Empty;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending message: {ex.Message}");
            }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 600px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f5f5f5;
    }

    .chat-header {
        padding: 15px;
        background-color: #007bff;
        color: white;
        border-radius: 8px 8px 0 0;
    }

    .chat-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background-color: white;
    }

    .message {
        padding: 10px 15px;
        border-radius: 8px;
        max-width: 70%;
        word-wrap: break-word;
    }

    .message.sent {
        align-self: flex-end;
        background-color: #007bff;
        color: white;
    }

    .message.received {
        align-self: flex-start;
        background-color: #e9ecef;
        color: black;
    }

    .username {
        font-weight: bold;
        display: block;
        font-size: 12px;
        margin-bottom: 4px;
        opacity: 0.8;
    }

    .content {
        display: block;
    }

    .timestamp {
        display: block;
        font-size: 11px;
        margin-top: 4px;
        opacity: 0.6;
    }

    .chat-input-area {
        display: flex;
        padding: 15px;
        gap: 10px;
        background-color: #f5f5f5;
        border-top: 1px solid #ddd;
    }

    .message-input {
        flex: 1;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .message-input:disabled {
        background-color: #e9ecef;
        cursor: not-allowed;
    }

    .send-button {
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
    }

    .send-button:hover:not(:disabled) {
        background-color: #0056b3;
    }

    .send-button:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }

    .connection-status {
        padding: 10px 15px;
        font-size: 12px;
        background-color: #f5f5f5;
        border-top: 1px solid #ddd;
        border-radius: 0 0 8px 8px;
    }

    .connection-status .connected {
        color: green;
        font-weight: bold;
    }

    .connection-status .disconnected {
        color: red;
        font-weight: bold;
    }
</style>
