@LogiTrack_HostAddress = http://localhost:5225
@userToken = paste-user-access-token-here
@adminToken = paste-admin-access-token-here

### Register a standard user
POST {{LogiTrack_HostAddress}}/api/auth/register
Content-Type: application/json

{
	"email": "user@example.com",
	"password": "ChangeThis-User-123"
}

### Log in as a standard user and copy accessToken from the response
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
	"email": "user@example.com",
	"password": "ChangeThis-User-123"
}

### Log in as the configured bootstrap admin and copy accessToken
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
	"email": "admin@example.com",
	"password": "ReplaceWithBootstrapAdminPassword"
}

### Create a fulfillment center
POST {{LogiTrack_HostAddress}}/api/fulfillment-centers/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"code": "SEA",
	"name": "Seattle Fulfillment Center",
	"location": "Seattle, WA"
}

### List fulfillment centers
GET {{LogiTrack_HostAddress}}/api/fulfillment-centers/
Authorization: Bearer {{userToken}}
Accept: application/json

### Create inventory at the fulfillment center (use its returned ID)
POST {{LogiTrack_HostAddress}}/api/inventory/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"sku": "BOX-001",
	"name": "Shipping Box",
	"fulfillmentCenterId": 1,
	"quantityOnHand": 100,
	"reorderLevel": 20,
	"unitPrice": 2.50
}

### List inventory across centers
GET {{LogiTrack_HostAddress}}/api/inventory/
Authorization: Bearer {{userToken}}
Accept: application/json

### View one inventory item
GET {{LogiTrack_HostAddress}}/api/inventory/1
Authorization: Bearer {{userToken}}
Accept: application/json

### Update an inventory item
PUT {{LogiTrack_HostAddress}}/api/inventory/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"sku": "BOX-001",
	"name": "Shipping Box",
	"fulfillmentCenterId": 1,
	"quantityOnHand": 120,
	"reorderLevel": 20,
	"unitPrice": 2.50
}

### Create an order (reserves inventory)
POST {{LogiTrack_HostAddress}}/api/orders/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"customerName": "Jordan Lee",
	"customerEmail": "jordan@example.com",
	"fulfillmentCenterId": 1,
	"items": [
		{
			"inventoryItemId": 1,
			"quantity": 2
		}
	]
}

### List orders
GET {{LogiTrack_HostAddress}}/api/orders/
Authorization: Bearer {{adminToken}}
Accept: application/json

### View one order
GET {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{adminToken}}
Accept: application/json

### Update order customer details or status
PUT {{LogiTrack_HostAddress}}/api/orders/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"customerName": "Jordan Lee",
	"customerEmail": "jordan@example.com",
	"status": "Processing"
}
