@page "/events"
@inject EventEase.Services.EventService EventService

<div class="dashboard-header">
    <h2>Events Dashboard</h2>
    <p>Browse upcoming events and explore details.</p>
</div>
<div class="event-grid">
    @foreach (var ev in events)
    {
        <div class="event-card">
            <h3>@ev.Name</h3>
            <p><strong>Date:</strong> @ev.Date.ToShortDateString()</p>
            <p><strong>Location:</strong> @ev.Location</p>

            <NavLink class="btn btn-primary" href="@($"/events/{ev.Id}")">
                View Details
            </NavLink>
        </div>
    }
</div>

@code {
    private IEnumerable<EventEase.Models.Event> events = Enumerable.Empty<EventEase.Models.Event>();

    protected override void OnInitialized()
    {
        events = EventService.GetEvents();
    }
}
