@page "/sessionstorage"
@using Blazored.SessionStorage

@inject ISessionStorageService SessionStorage


<h3>Shopping Cart (Session Storage)</h3>

<div class="mb-3">
    <input class="form-control"
           placeholder="Enter product name"
           @bind="newProduct" />

    <button class="btn btn-primary mt-2" @onclick="AddProduct">Add to Cart</button>
    <button class="btn btn-danger mt-2 ms-2" @onclick="ClearCart">Clear Cart</button>
</div>

@if (cart.Count == 0)
{
    <p class="text-muted">Your cart is empty.</p>
}
else
{
    <ul class="list-group">
        @foreach (var product in cart)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                @product
                <button class="btn btn-sm btn-outline-danger"
                        @onclick="() => RemoveProduct(product)">
                    Remove
                </button>
            </li>
        }
    </ul>
}

@code {
    private const string CartKey = "shopping-cart";
    private List<string> cart = new();
    private string? newProduct;

    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
    }

    private async Task LoadCart()
    {
        cart = await SessionStorage.GetItemAsync<List<string>>(CartKey) ?? new();
    }

    private async Task SaveCart()
    {
        await SessionStorage.SetItemAsync(CartKey, cart);
    }

    private async Task AddProduct()
    {
        if (!string.IsNullOrWhiteSpace(newProduct))
        {
            cart.Add(newProduct);
            newProduct = string.Empty;
            await SaveCart();
        }
    }

    private async Task RemoveProduct(string product)
    {
        cart.Remove(product);
        await SaveCart();
    }

    private async Task ClearCart()
    {
        cart.Clear();
        await SessionStorage.RemoveItemAsync(CartKey);
    }
}
