### ---------------------------------------------------------
### Global Variables
### ---------------------------------------------------------
@host = http://localhost:5119
@token = my-secret-token

### ---------------------------------------------------------
### 1. Create User (Valid Token)
### ---------------------------------------------------------
POST {{host}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Joseph",
  "email": "joseph@example.com"
}

### ---------------------------------------------------------
### 2. Create User (Invalid Token)
### ---------------------------------------------------------
POST {{host}}/api/users
Authorization: Bearer wrong-token
Content-Type: application/json

{
  "name": "Invalid User",
  "email": "invalid@example.com"
}

### ---------------------------------------------------------
### 3. Create User (Validation Error)
### ---------------------------------------------------------
POST {{host}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "J",              // Too short
  "email": "not-an-email"   // Invalid email
}

### ---------------------------------------------------------
### 4. Get All Users
### ---------------------------------------------------------
GET {{host}}/api/users
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 5. Get User by ID
### ---------------------------------------------------------
GET {{host}}/api/users/1
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 6. Get User by ID (Not Found)
### ---------------------------------------------------------
GET {{host}}/api/users/999
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 7. Update User
### ---------------------------------------------------------
PUT {{host}}/api/users/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Joseph Updated",
  "email": "new@example.com"
}

### ---------------------------------------------------------
### 8. Update User (Validation Error)
### ---------------------------------------------------------
PUT {{host}}/api/users/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "email": "bad-email"
}

### ---------------------------------------------------------
### 9. Delete User
### ---------------------------------------------------------
DELETE {{host}}/api/users/1
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 10. Delete User (Not Found)
### ---------------------------------------------------------
DELETE {{host}}/api/users/999
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 11. Search Users
### ---------------------------------------------------------
GET {{host}}/api/users/search?term=jose
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 12. Search Users (Empty Term)
### ---------------------------------------------------------
GET {{host}}/api/users/search?term=
Authorization: Bearer {{token}}

### ---------------------------------------------------------
### 13. Missing Authorization Header
### ---------------------------------------------------------
GET {{host}}/api/users

### ---------------------------------------------------------
### 14. Malformed Authorization Header
### ---------------------------------------------------------
GET {{host}}/api/users
Authorization: Token abc123

### ---------------------------------------------------------
### 15. Valid Token Smoke Test
### ---------------------------------------------------------
GET {{host}}/api/users
Authorization: Bearer {{token}}
